# ── Payload CMS ─────────────────────────────────────────────────────────────
# Ilga atsitiktinė eilutė. Sugeneruoti:  openssl rand -base64 32
PAYLOAD_SECRET=

# SQLite failas. SVARBU: serveryje kelias turi rodyti UŽ aplikacijos aplanko
# ribų, kitaip diegimas iš GitHub ištrins visą turinį.
#   vietoje:   file:./vardiklis.db
#   serveryje: file:/home/UŽSAKOVAS/payload/vardiklis.db
DATABASE_URI=file:./vardiklis.db

# Įkeltų failų katalogas (paveikslėliai ir PDF). Ta pati taisyklė —
# serveryje nurodyti kelią už repozitorijos ribų.
#   serveryje: /home/UŽSAKOVAS/payload/ikelta
UPLOADS_DIR=public/ikelta
