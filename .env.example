# ── Payload CMS ─────────────────────────────────────────────────────────────
# Ilga atsitiktinė eilutė. Sugeneruoti:  openssl rand -base64 32
PAYLOAD_SECRET=

# SQLite failas.
#
# KELIAS PRIVALO BŪTI ABSOLIUTUS. Savarankiškas (standalone) serveris veikia
# .next/standalone kataloge, todėl santykinis `file:./vardiklis.db` nurodytų
# ne tą vietą — tyliai susikurtų tuščia bazė ir puslapiai grąžintų 500.
#
# Serveryje kelias dar turi rodyti UŽ aplikacijos aplanko ribų, nes kiekvienas
# diegimas iš GitHub perrašo aplikacijos aplanką ir ištrintų visą turinį.
#   vietoje:   file:/home/tomastt123/math/vardiklis/vardiklis.db
#   serveryje: file:/home/UŽSAKOVAS/duomenys/vardiklis.db
DATABASE_URI=

# Įkeltų failų katalogas (paveikslėliai ir PDF). Tos pačios dvi taisyklės:
# absoliutus kelias ir serveryje — už repozitorijos ribų.
#   serveryje: /home/UŽSAKOVAS/duomenys/ikelta
UPLOADS_DIR=

# ── Registracijos formos laiškai ────────────────────────────────────────────
# Formą užpildžius, laišką išsiunčia SERVERIS (lib/uzklausa.ts). Nenurodžius
# SMTP_USER arba SMTP_PASS forma parodo telefoną ir el. paštą, o siuntimo
# nebando — tyliai užklausa nedingsta.
#
# GMAIL: paprastas paskyros slaptažodis NEVEIKS. Reikia:
#   1. Google paskyra → Security → įjungti 2-Step Verification;
#   2. ten pat → App passwords → sukurti „Vardiklis";
#   3. gautus 16 simbolių (be tarpų) įrašyti į SMTP_PASS.
# 587 = STARTTLS (numatyta ir patikimiausia). 465 = TLS iš karto — jei tinkle
# yra neveikiantis IPv6, prie 465 sujungimas nulūžta, o prie 587 persijungia į IPv4.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Kam ateina užklausos. Nenurodžius — tas pats SMTP_USER.
UZKLAUSU_PASTAS=

# ── Automatiniai pamokų priminimai ──────────────────────────────────────────
# Slaptažodis maršrutui, kuris išsiunčia priminimus tėvams. Be jo maršrutas
# neveikia visai (atsako 503), o su neteisingu — 401. Sugeneruoti:
#   openssl rand -hex 24
#
# TIK RAIDĖS IR SKAIČIAI. `-base64` netinka: jame pasitaiko `+`, `/` ir `=`, o
# adreso eilutėje `+` reiškia tarpą — raktas nebesutampa ir maršrutas atsako
# „Neleista“ (401), nors hPanel'yje įrašyta viskas teisingai.
#
# Cron'as (Hostinger hPanel arba nemokamas cron-job.org) kviečia jį kas 5 min.:
#   */5 * * * *  curl -s "https://vardiklis.lt/vidus/priminimai?raktas=TAVO_RAKTAS"
#
# Kas 5 min., o ne kartą per rytą, todėl, kad siuntimo valanda gyvena CMS'e
# (globalas „Priminimai“) — ją pakeitus serverio liesti nereikia.
#
# Laiškai eina per tą patį SMTP, kaip ir registracijos forma.
PRIMINIMU_RAKTAS=

# ── i.SAF (VMI išrašomų PVM sąskaitų faktūrų registras) ─────────────────────
# Reikalinga TIK PVM mokėtojui ir tik tada, kai registrą norima teikti
# automatiškai. Be šitų kintamųjų skydelis vis tiek sudaro rinkmeną ir leidžia
# ją atsisiųsti — ją galima įkelti ranka per imas.vmi.lt.
#
# SERTIFIKATAS GAUNAMAS RANKA, kodu jo susikurti neįmanoma:
#   1. i.MAS portale (imas.vmi.lt) užsakomas kliento sertifikatas;
#   2. sugeneruojamas CSR ir įkeliamas ten;
#   3. gautas sertifikatas ir privatus raktas įrašomi į failus SERVERYJE, už
#      repozitorijos ribų — lygiai kaip DATABASE_URI ir UPLOADS_DIR.
#
# PIRMIAUSIA DEMO. Gyvoje aplinkoje pateiktas registras yra deklaracija, o
# demo leidžia visą kelią pereiti be pasekmių.
ISAF_APLINKA=demo

# Kliento sertifikatas ir privatus raktas (PEM). Jei abu viename faile —
# ISAF_RAKTAS galima palikti tuščią.
ISAF_SERTIFIKATAS=
ISAF_RAKTAS=
ISAF_RAKTO_SLAPTAZODIS=

# Paliekami tušti. Prireikia tik tada, kai VMI pakeičia adresą arba paslaugos
# sritį (namespace) — įprastai sritis nuskaitoma iš WSDL automatiškai.
ISAF_ADRESAS=
ISAF_SRITIS=
